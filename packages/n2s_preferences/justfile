set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

default:
    @just --list

fmt:
    uv run ruff format .

fmt-check:
    uv run ruff format --check .

lint:
    uv run ruff check --fix .

lint-check:
    uv run ruff check .

typecheck:
    uv run ty check n2s_preferences

test:
    uv run python -m unittest n2s_preferences.test_client -v
