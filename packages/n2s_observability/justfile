set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

default:
    @just --list

fmt:
    uv run ruff format .

fmt-check:
    uv run ruff format --check .

lint:
    uv run ruff check --fix .

lint-check:
    uv run ruff check .

typecheck:
    uv run ty check n2s_observability

test:
    @echo "n2s_observability: no tests"
