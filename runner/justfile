set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

default:
    @just --list

fmt:
    uv run ruff format .

fmt-check:
    uv run ruff format --check .

lint:
    uv run ruff check .

typecheck:
    uv run ty check

# No unit tests in this package yet
test:
    @echo "runner: no tests"
